<Window x:Class="Kalkulator_i_Rejestr_Wynagrodzen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator i Rejestr Wynagrodzeń" Height="450" Width="720" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kalkulator Wynagrodzeń - Autor: Kacper Dondzik" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Dane Wejściowe" Margin="0,0,10,0" Padding="10">
                <StackPanel>
                    <Label Content="Wynagrodzenie brutto w PLN" Padding="0,0,0,3"/>
                    <TextBox x:Name="txtBrutto" Text="5000,00" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

                    <GroupBox Header="Rodzaj Umowy" Margin="0,0,0,15" Padding="5">
                        <StackPanel>
                            <RadioButton x:Name="rbUmowaOPrace" Content="Umowa o pracę" IsChecked="True" Margin="0,5"/>
                            <RadioButton x:Name="rbUmowaZlecenie" Content="Umowa zlecenie" Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="chkUlga" Content="Ulga dla młodych &lt; 26 lat" Margin="0,5,0,20"/>

                    <Button x:Name="btnOblicz" Content="OBLICZ I ZAPISZ" Background="#1E65D6" Foreground="White" FontWeight="Bold" Height="45" Click="BtnOblicz_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Wyniki i Historia" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="txtWynikNetto" Text="Wynagrodzenie netto: 3500,00 PLN" FontSize="18" FontWeight="Bold" Foreground="Green" Margin="0,0,0,10"/>

                    <GroupBox Header="Szczegóły Składek i Podatków" Margin="0,0,0,10" Padding="5">
                        <StackPanel>
                            <TextBlock x:Name="txtZus" Text="👥 Składki ZUS (społeczne): 0,00 PLN" Margin="0,3"/>
                            <TextBlock x:Name="txtZdrowotna" Text="🛡️ Składka zdrowotna: 0,00 PLN" Margin="0,3"/>
                            <TextBlock x:Name="txtPit" Text="📄 Zaliczka na podatek PIT: 0,00 PLN" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Rejestr Wynagrodzeń" Padding="5">
                        <DataGrid x:Name="dgRejestr" AutoGenerateColumns="False" Height="140" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="85"/>
                                <DataGridTextColumn Header="Kwota Brutto" Binding="{Binding KwotaBrutto}" Width="95"/>
                                <DataGridTextColumn Header="Umowa" Binding="{Binding Umowa}" Width="85"/>
                                <DataGridTextColumn Header="Netto" Binding="{Binding Netto}" Width="90"/>
                                <DataGridTextColumn Header="Ulga" Binding="{Binding Ulga}" Width="45"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
